# ---- Database (Neon) ----
# Pooled (PgBouncer) connection string — used by the app for request traffic.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-aws-pooler.neon.tech/DBNAME?sslmode=verify-full
# Unpooled (direct) connection string — used by `npm run db:push` / `db:studio`.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=verify-full

# ---- Clerk (Authentication) ----
# Find these in the Clerk dashboard (API Keys -> Keys).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx

# ---- Daytona (Game sandboxes) ----
# https://daytona.io — access token used to create and manage game sandboxes.
DAYTONA_API_KEY=

# ---- Trigger.dev (Background chat tasks) ----
# From the Trigger.dev project's settings; used for `tasks.trigger` auth.
TRIGGER_SECRET_KEY=

# ---- Anthropic (AI models) ----
# Server-side key used by the Trigger.dev chat agent for Claude requests.
ANTHROPIC_API_KEY=

# ---- OpenAI (AI models) ----
# Server-side key used by the Trigger.dev chat agent for GPT requests.
OPENAI_API_KEY=

# ---- Sentry (Error tracking) ----
# Client-side DSN.
NEXT_PUBLIC_SENTRY_DSN=https://EXAMPLE@oXXXX.ingest.sentry.io/XXXX
# Server-side DSN (Node, Edge, and Trigger worker).
SENTRY_DSN=https://EXAMPLE@oXXXX.ingest.sentry.io/XXXX
# Only needed to upload source maps during `next build` / trigger deploys.
SENTRY_AUTH_TOKEN=sntrys_xxxx
SENTRY_ORG=enra-r3
SENTRY_PROJECT=sandbox
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_ENVIRONMENT=development

# ---- Optional (overrides / deployment) ----
# Release name; falls back to RAILWAY_GIT_COMMIT_SHA, then unset.
SENTRY_RELEASE=
# Injected by Railway on deploy.
RAILWAY_ENVIRONMENT_NAME=
RAILWAY_GIT_COMMIT_SHA=
